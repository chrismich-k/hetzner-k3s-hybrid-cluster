apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: oauth2-proxy
  namespace: kube-system
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ auth_domain }}`)
      kind: Rule
      services:
        - name: oauth2-proxy
          namespace: kube-system
          port: 4180
  tls:
    secretName: authdomain-tls-secret
